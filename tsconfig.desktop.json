{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "desktop-dist",
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "desktop/main/**/*.ts", "desktop/preload/**/*.ts", "desktop/shared/**/*.ts"],
  "exclude": ["desktop/renderer/**/*.ts"]
}
