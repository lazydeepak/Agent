{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": []
  },
  "include": ["desktop/renderer/**/*.ts", "desktop/shared/**/*.ts", "desktop/preview/preview-bridge.ts", "src/contracts/**/*.ts"]
}
